doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(http-equiv="Content-Security-Policy" content="default-src 'self' data: https://ssl.gstatic.com 'unsafe-eval'; style-src 'self' 'unsafe-inline'; media-src *; img-src 'self' data: content:;")
  meta(charset="UTF-8") 
  meta(name="viewport" content="width=device-width, initial-scale=1.0") 
  title Gtk Webview
  each link in links
    link(rel="stylesheet" href=link)  
  script(src="js/ready.js")
  body.animated.fadeIn.slow
    div.flex.flex-row.w-full.h-14.gray200.justify-start.items-center
      span.text-2xl.text-blue900.font-bold.pl-5.cursor-pointer Navbar  
    h1 pp-router #{title}
    nav.flex.flex-row.gap-2
      a.pl-2.pr-2(href="#/") Home
      a.pl-2.pr-2(href="#/about") About Us
      a.pl-2.pr-2(href="#/users/123") User 123
      a.pl-2.pr-2(href="#/products/apple-iphone-x") Product: Apple iPhone X
      a.pl-2.pr-2(href="#/files/documents/report.pdf") File: Report PDF
      a.pl-2.pr-2(href="#/nonexistent") Non-existent Page    
    h2 Current Route:
    pre(id="route-info") No route active yet.
    button(id="close") close
    script(src="js/index.js")    